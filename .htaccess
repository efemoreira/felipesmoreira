RewriteEngine On
RewriteBase /
# Se o arquivo ou diretório existe, serve normalmente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Redireciona /rota para /rota.html
RewriteRule ^([^/]+)$ $1.html [L]
# Redireciona tudo que não existir para index.html (SPA fallback)
RewriteRule ^ index.html [QSA,L]

# ===== MIME correto p/ rotas de metadata do Next (sem extensão) =====
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<FilesMatch "^(opengraph-image|twitter-image|apple-icon|icon)$">
  ForceType image/png
</FilesMatch>

# ===== Headers de segurança =====
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-DNS-Prefetch-Control "on"
</IfModule>

# ===== Compressão (GZIP) =====
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# ===== Cache de estáticos =====
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

# Assets versionados do Next (_next/static) — imutáveis
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
